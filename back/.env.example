SERVER_PORT=:8080

# Database settings. DB_TYPE acepta: sqlite | postgres
DB_TYPE=sqlite

# SQLite (por defecto)
DB_PATH=data/template.db

# PostgreSQL (usar cuando DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=template
# No se fuerza SSL: usa require/verify-full si tu servidor lo soporta,
# o disable en local / servidores sin TLS.
DB_SSLMODE=disable

# JWT settings
# OBLIGATORIO: mínimo 32 caracteres. Generar con:
#   go run ./cmd/generate_secrets.go
# El backend no arranca si falta o es demasiado corto.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
JWT_RENEW_MINUTES=5

# Cookie settings (en producción: COOKIE_SECURE=true y HTTPS)
COOKIE_NAME=access_token_go
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:4200

# Primer administrador (opcional).
# Si BOOTSTRAP_ADMIN_PASSWORD está vacío NO se crea ningún usuario.
# La contraseña debe cumplir la política (12+ caracteres) y se fuerza
# el cambio en el primer login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Rate limiting del login (además del limit_req de nginx)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# Reportes / documentos
REPORT_SYNC_TIMEOUT_SECONDS=60
JOB_TTL_MINUTES=30

# Raiz del template en nginx. El codigo usa /public/imagenes para imagenes
# publicas y /archivos para archivos privados (nginx bloquea /archivos; los sirve Go).
PUBLIC_DIR=C:\Andriw 2\nginx-1.28.0\html\template

# Archivos privados servidos por Go (vacio = http.ServeFile directo)
X_ACCEL_REDIRECT_PREFIX=
