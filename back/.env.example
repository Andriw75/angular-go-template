SERVER_PORT=:8080

# Database settings. DB_TYPE acepta: sqlite | postgres
DB_TYPE=sqlite

# SQLite (por defecto)
DB_PATH=data/template.db

# PostgreSQL (usar cuando DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=template
DB_SSLMODE=disable

# JWT settings
JWT_SECRET=REDACTED_DEFAULT_JWT_SECRET
JWT_EXPIRATION_MINUTES=15
JWT_RENEW_MINUTES=5

# Cookie settings
COOKIE_NAME=access_token_go
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:4200

# Reportes / documentos
REPORT_SYNC_TIMEOUT_SECONDS=60
JOB_TTL_MINUTES=30

# Raiz del template en nginx. El codigo usa /public/imagenes para imagenes
# publicas y /archivos para archivos privados (nginx bloquea /archivos; los sirve Go).
PUBLIC_DIR=C:\Andriw 2\nginx-1.28.0\html\template

# Archivos privados servidos por Go (vacio = http.ServeFile directo)
X_ACCEL_REDIRECT_PREFIX=
