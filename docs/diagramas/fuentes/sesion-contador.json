  "cards": [
    {
      "dot": "cyan",
      "title": "El backend solo informa",
      "items": [
        "X-Session-Expires-In viaja en login, /auth/me y rutas autenticadas.",
        "El valor se calcula después de una posible renovación.",
        "Mostrar el contador y auto-cerrar es decisión exclusiva del frontend."
      ]
    },
    {
      "dot": "amber",
      "title": "Renovación deslizante",
      "items": [
        "El middleware renueva cada 5 minutos si hay actividad.",
        "El contador mide el token actual, no la sesión total.",
        "Solo llega a 0 si pasan 15 minutos sin renovación."
      ]
    },
    {
      "dot": "rose",
      "title": "Límites",
      "items": [
        "Pestañas en segundo plano pueden frenar el timer; se recalcula al volver.",
        "No hay sincronización multi-pestaña.",
        "Al expirar no se llama a /auth/logout: el token ya no sirve."
      ]
    }
  ]
