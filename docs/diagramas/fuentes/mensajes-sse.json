  "cards": [
    {
      "dot": "cyan",
      "title": "Qué transporta SSE",
      "items": [
        "Un solo contrato: SSEEvent { type, data }.",
        "El type viaja dentro del JSON, no como campo event:.",
        "El canal es unidireccional: servidor a cliente; las escrituras siguen siendo REST."
      ]
    },
    {
      "dot": "amber",
      "title": "Dos patrones de actualización",
      "items": [
        "Mensajes activas: caché en memoria + broadcast a todos.",
        "Buses, tienda, archivos y pasadas: consulta bajo demanda con paginación de servidor.",
        "Los filtros de mensajes activas se resuelven en cliente."
      ]
    },
    {
      "dot": "rose",
      "title": "Límites del diseño",
      "items": [
        "El hub no conoce identidad: todos reciben todos los eventos.",
        "Buffer de 64; si un cliente se atrasa, pierde eventos y se resincroniza al reconectar.",
        "Sin replay ni Last-Event-ID; el estado vive por proceso."
      ]
    }
  ]
