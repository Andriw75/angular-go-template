  "cards": [
    {
      "dot": "cyan",
      "title": "Regla clave",
      "items": [
        "La contraseña viaja en el cuerpo y no se guarda en el navegador.",
        "Lo que persiste es un JWT en una cookie HttpOnly, inaccesible para JavaScript.",
        "El JWT lleva user_id, permisos, jti y expiración."
      ]
    },
    {
      "dot": "amber",
      "title": "F5 o pestaña nueva",
      "items": [
        "El signal auth.user se pierde al recargar.",
        "El guard consulta GET /auth/me para restaurar la sesión desde la cookie.",
        "Si la cookie no es válida, el guard redirige a /login."
      ]
    },
    {
      "dot": "rose",
      "title": "Errores esperados",
      "items": [
        "400 si falta usuario o contraseña.",
        "401 invalid credentials si bcrypt no coincide.",
        "403 en una ruta protegida si el permiso no está en el JWT."
      ]
    }
  ]
