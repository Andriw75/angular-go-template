  "cards": [
    {
      "dot": "cyan",
      "title": "Cierre normal",
      "items": [
        "El navegador corta SSE, detiene el contador y limpia auth.user.",
        "La API elimina el jti del registro en memoria y borra la cookie.",
        "Al llegar a /login, loginGuard consulta /auth/me y recibe 401."
      ]
    },
    {
      "dot": "amber",
      "title": "Revocación por permisos",
      "items": [
        "PUT /users/{id} ejecuta RemoveUserTokens si cambian permisos o activo.",
        "Con LOAD=true la siguiente request recarga el usuario y emite un JWT nuevo.",
        "Con LOAD=false o usuario inactivo responde 401 session expired."
      ]
    },
    {
      "dot": "rose",
      "title": "Límites conocidos",
      "items": [
        "Eliminar un usuario no revoca sus tokens.",
        "Cambios directos en BD no disparan RemoveUserTokens.",
        "El registro es por proceso: en multi-instancia la revocación no es global."
      ]
    }
  ]
