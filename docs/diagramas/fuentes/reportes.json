  "cards": [
    {
      "dot": "cyan",
      "title": "Dos motores, un JSON",
      "items": [
        "Navegador: jsPDF + jspdf-autotable o ExcelJS.",
        "Servidor: go-pdf/fpdf o excelize/v2.",
        "El mismo JSON alimenta los cuatro formatos."
      ]
    },
    {
      "dot": "amber",
      "title": "Datos actuales o generados",
      "items": [
        "Solo Buses admite datos autogenerados, hasta 1000 por solicitud.",
        "Los datos sintéticos no se insertan en la tabla buses.",
        "Si se emite un documento con datos generados, usa la serie GEN."
      ]
    },
    {
      "dot": "rose",
      "title": "Documentos y jobs",
      "items": [
        "El hash incluye tipo, versión de plantilla y parámetros canónicos.",
        "Inmutable devuelve el existente; actualizable crea una nueva versión.",
        "Si la generación supera 60 s, responde 202 y el job vive 30 min en memoria."
      ]
    }
  ]
