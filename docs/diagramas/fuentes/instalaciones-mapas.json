  "cards": [
    {
      "dot": "cyan",
      "title": "Sin permiso específico",
      "items": [
        "La ruta usa AuthMiddleware() sin permiso adicional.",
        "Cualquier usuario logueado puede ver y modificar instalaciones.",
        "El menú Mapas no declara requiredPermission."
      ]
    },
    {
      "dot": "amber",
      "title": "Estado en cliente",
      "items": [
        "GET /instalaciones devuelve todo el listado en una sola llamada.",
        "Búsqueda, tipo, estado y zona se filtran localmente.",
        "Seleccionar una tarjeta hace flyTo al marcador; cambiar filtros usa fitBounds."
      ]
    },
    {
      "dot": "rose",
      "title": "Límites",
      "items": [
        "Sin paginación ni clustering: miles de marcadores degradan el mapa.",
        "El backend no valida tipo, estado, zona ni rangos de lat/lng.",
        "Sin geocodificación y sin control de concurrencia; el mapa arranca vacío."
      ]
    }
  ]
